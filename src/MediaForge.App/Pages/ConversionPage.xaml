<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MediaForge.App.Pages.ConversionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Uid="ConversionTitle" Style="{StaticResource TitleTextBlockStyle}" />

        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton x:Uid="AddFilesButton" Icon="Add" />
                <AppBarButton x:Uid="AddFolderButton" Icon="Folder" />
                <AppBarButton x:Uid="StartButton" Icon="Play" />
            </CommandBar.PrimaryCommands>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Uid="ClearButton" Icon="Delete" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="2">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon Glyph="&#xE8B7;" FontSize="40" />
                <TextBlock
                    HorizontalAlignment="Center"
                    x:Uid="EmptyTitle"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    x:Uid="EmptyDescription"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
