<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MediaForge.App.Pages.ConversionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock x:Name="TitleTextBlock" Style="{StaticResource TitleTextBlockStyle}" />
            <Border
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="2">
                <CommandBar
                    x:Name="FloatingCommandBar"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="False">
                    <CommandBar.PrimaryCommands>
                        <AppBarButton x:Name="AddFilesButton" Icon="Add" Click="OnAddFilesClick" />
                        <AppBarButton x:Name="AddFolderButton" Icon="Folder" Click="OnAddFolderClick" />
                        <AppBarButton x:Name="StartButton" Icon="Play" Click="OnStartClick" />
                        <AppBarButton x:Name="ClearButton" Icon="Delete" Click="OnClearClick" />
                        <AppBarButton x:Name="ExitButton" Icon="Cancel" Click="OnExitClick" />
                        <AppBarButton x:Name="ToggleCommandBarButton" Icon="Back" Click="OnToggleCommandBarClick" />
                    </CommandBar.PrimaryCommands>
                </CommandBar>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Padding="0,4,0,4">
            <TextBlock
                x:Name="PresetLabel"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox
                x:Name="PresetComboBox"
                MinWidth="180"
                SelectionChanged="OnPresetSelectionChanged" />
            <TextBlock
                x:Name="OutputDirectoryLabel"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox
                x:Name="OutputDirectoryModeComboBox"
                MinWidth="210"
                SelectionChanged="OnOutputDirectoryModeChanged">
                <ComboBoxItem x:Name="SourceSiblingOutputDirectoryOption" />
                <ComboBoxItem x:Name="SettingsDefaultDirectoryOption" />
                <ComboBoxItem x:Name="MainPageOutputDirectoryOption" />
            </ComboBox>
            <TextBox
                x:Name="MainPageOutputDirectoryTextBox"
                Width="240"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                LostFocus="OnMainPageOutputDirectoryLostFocus" />
            <Button
                x:Name="BrowseMainPageOutputDirectoryButton"
                VerticalAlignment="Center"
                Visibility="Collapsed"
                Click="OnBrowseMainPageOutputDirectoryClick"
                Content="..." />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="6">
            <InfoBar
                x:Name="ConversionStatusInfoBar"
                IsClosable="True"
                IsOpen="False" />
            <StackPanel x:Name="OverallProgressPanel" Visibility="Collapsed" Spacing="2">
                <TextBlock x:Name="OverallProgressTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="OverallProgressBar" Maximum="100" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="3" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                x:Name="MediaListView"
                SelectionMode="Extended"
                IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8" Spacing="2">
                            <TextBlock Text="{Binding FileName}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding QueueStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Visibility="{Binding ProgressVisibility}" />
                            <TextBlock Text="{Binding ProgressText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon Glyph="&#xE8B7;" FontSize="40" />
                <TextBlock
                    HorizontalAlignment="Center"
                    x:Name="EmptyTitleTextBlock"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    x:Name="EmptyDescriptionTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
