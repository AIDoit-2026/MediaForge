<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MediaForge.App.Pages.ConversionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock" Style="{StaticResource TitleTextBlockStyle}" />

        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton x:Name="AddFilesButton" Icon="Add" Click="OnAddFilesClick" />
                <AppBarButton x:Name="AddFolderButton" Icon="Folder" Click="OnAddFolderClick" />
                <AppBarButton x:Name="StartButton" Icon="Play" Click="OnStartClick" />
            </CommandBar.PrimaryCommands>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="ClearButton" Icon="Delete" Click="OnClearClick" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <StackPanel Grid.Row="2" Spacing="6">
            <InfoBar
                x:Name="ConversionStatusInfoBar"
                IsClosable="True"
                IsOpen="False" />
            <StackPanel x:Name="OverallProgressPanel" Visibility="Collapsed" Spacing="2">
                <TextBlock x:Name="OverallProgressTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ProgressBar x:Name="OverallProgressBar" Maximum="100" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="3" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView
                x:Name="MediaListView"
                SelectionMode="Extended"
                IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="8" Spacing="2">
                            <TextBlock Text="{Binding FileName}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding QueueStatus}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Visibility="{Binding ProgressVisibility}" />
                            <TextBlock Text="{Binding ProgressText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon Glyph="&#xE8B7;" FontSize="40" />
                <TextBlock
                    HorizontalAlignment="Center"
                    x:Name="EmptyTitleTextBlock"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    x:Name="EmptyDescriptionTextBlock"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
