<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MediaForge.App.Pages.ConversionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="转换" Style="{StaticResource TitleTextBlockStyle}" />

        <CommandBar Grid.Row="1" DefaultLabelPosition="Right">
            <CommandBar.PrimaryCommands>
                <AppBarButton Icon="Add" Label="添加文件" />
                <AppBarButton Icon="Folder" Label="添加文件夹" />
                <AppBarButton Icon="Play" Label="开始转换" />
            </CommandBar.PrimaryCommands>
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Delete" Label="清空队列" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="2">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <FontIcon Glyph="&#xE8B7;" FontSize="40" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="添加媒体文件以开始转换"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Text="支持多选、拖放和按条件导入文件夹"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
