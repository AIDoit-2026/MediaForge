<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MediaForge.App.Pages.FolderImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <StackPanel Spacing="12">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="DirectoryTextBox" Grid.Column="0" />
            <Button x:Name="BrowseDirectoryButton" Grid.Column="1" Click="OnBrowseDirectoryClick" Content="..." />
        </Grid>
        <CheckBox x:Name="RecursiveCheckBox" />
        <ComboBox x:Name="FilterModeComboBox" SelectionChanged="OnFilterModeChanged">
            <ComboBoxItem x:Name="AllFilesOption" Tag="0" />
            <ComboBoxItem x:Name="KeywordOption" Tag="1" />
            <ComboBoxItem x:Name="WildcardOption" Tag="2" />
            <ComboBoxItem x:Name="RegularExpressionOption" Tag="3" />
        </ComboBox>
        <TextBox x:Name="ExpressionTextBox" />
        <InfoBar x:Name="ValidationInfoBar" IsOpen="False" IsClosable="False" Severity="Error" />
    </StackPanel>
</ContentDialog>
