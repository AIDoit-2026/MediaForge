<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="MediaForge.App.Pages.FolderImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <StackPanel Spacing="12">
        <TextBox x:Name="DirectoryTextBox" Header="Folder" PlaceholderText="Choose a folder to scan" />
        <CheckBox x:Name="RecursiveCheckBox" Content="Include subfolders" />
        <ComboBox x:Name="FilterModeComboBox" Header="Filter" SelectionChanged="OnFilterModeChanged">
            <ComboBoxItem Content="All files" Tag="0" />
            <ComboBoxItem Content="Keyword" Tag="1" />
            <ComboBoxItem Content="Wildcard (* and ?)" Tag="2" />
            <ComboBoxItem Content="Regular expression" Tag="3" />
        </ComboBox>
        <TextBox x:Name="ExpressionTextBox" Header="Expression" />
        <InfoBar x:Name="ValidationInfoBar" IsOpen="False" IsClosable="False" Severity="Error" />
    </StackPanel>
</ContentDialog>
