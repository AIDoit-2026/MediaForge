<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MediaForge.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation">

    <ScrollViewer>
        <StackPanel Padding="24,16,24,24" Spacing="16">
            <TextBlock x:Name="TitleTextBlock" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                x:Name="DescriptionTextBlock"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <InfoBar
                x:Name="StatusInfoBar"
                IsClosable="True"
                IsOpen="False" />

            <Grid ColumnSpacing="16" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="LanguageLabel" Grid.Row="0" VerticalAlignment="Center" />
                <ComboBox x:Name="LanguageComboBox" Grid.Row="0" Grid.Column="1" SelectedIndex="0">
                    <ComboBoxItem x:Name="SystemLanguageOption" />
                    <ComboBoxItem x:Name="ChineseLanguageOption" />
                    <ComboBoxItem x:Name="EnglishLanguageOption" />
                </ComboBox>

                <TextBlock x:Name="ThemeLabel" Grid.Row="1" VerticalAlignment="Center" />
                <ComboBox x:Name="ThemeComboBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0">
                    <ComboBoxItem x:Name="SystemThemeOption" />
                    <ComboBoxItem x:Name="LightThemeOption" />
                    <ComboBoxItem x:Name="DarkThemeOption" />
                </ComboBox>

                <TextBlock x:Name="FfmpegDirectoryLabel" Grid.Row="2" VerticalAlignment="Center" />
                <TextBox
                    x:Name="FfmpegDirectoryTextBox"
                    Grid.Row="2"
                    Grid.Column="1"
                    />

                <TextBlock x:Name="DefaultOutputDirectoryLabel" Grid.Row="3" VerticalAlignment="Center" />
                <TextBox
                    x:Name="DefaultOutputDirectoryTextBox"
                    Grid.Row="3"
                    Grid.Column="1"
                    />

                <TextBlock x:Name="ConflictPolicyLabel" Grid.Row="4" VerticalAlignment="Center" />
                <ComboBox x:Name="ConflictPolicyComboBox" Grid.Row="4" Grid.Column="1" SelectedIndex="2">
                    <ComboBoxItem x:Name="SkipConflictOption" />
                    <ComboBoxItem x:Name="OverwriteConflictOption" />
                    <ComboBoxItem x:Name="RenameConflictOption" />
                </ComboBox>

                <TextBlock x:Name="MaxConcurrencyLabel" Grid.Row="5" VerticalAlignment="Center" />
                <NumberBox
                    x:Name="MaxConcurrencyNumberBox"
                    Grid.Row="5"
                    Grid.Column="1"
                    Maximum="4"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="1" />
            </Grid>

            <Button
                x:Name="SaveButton"
                HorizontalAlignment="Left"
                Click="OnSaveClick"
                 />
        </StackPanel>
    </ScrollViewer>
</Page>
