<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MediaForge.App.Pages.PresetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MediaForge.App.Pages">

    <StackPanel Padding="24,16,24,24" Spacing="16">
        <TextBlock x:Name="TitleTextBlock" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBlock
            x:Name="DescriptionTextBlock"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TeachingTip
            x:Name="UsePresetConfirmationTeachingTip"
            IsLightDismissEnabled="True"
            PreferredPlacement="Bottom" />
        <ListView x:Name="PresetListView" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PresetItem">
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{x:Bind Name}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind Description}" />
                            <TextBlock
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind SelectedText}"
                                Visibility="{x:Bind SelectedVisibility}" />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Click="OnUsePresetClick"
                            Content="{x:Bind UseButtonText}"
                            DataContext="{x:Bind}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</Page>
